{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/mitrocare/",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/mitrocare/",
      "permanent": false
    },
    {
      "source": "/assets/:path*",
      "destination": "/mitrocare/assets/:path*",
      "permanent": false
    },
    {
      "source": "/Popravki_index_copy.html",
      "destination": "/mitrocare/Popravki_index_copy.html",
      "permanent": true
    }
  ]
}
